# Copy this file and rename the copy to .env
PORT=3000

# Create your own private admin password/key. Do not share it.
ADMIN_KEY=replace-this-with-a-long-private-password

# Email sender settings (SMTP). Ask your email provider for these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Semaphore Philippines SMS API key
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=CLASSGUARD
